<resources>

    <style name="Base.AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="fontFamily">@font/notas_sans</item>
        <item name="android:fontFamily">@font/notas_sans</item>
        <item name="colorSecondary">?attr/colorPrimary</item>
        <item name="colorOnSecondary">?attr/colorOnPrimary</item>

        <item name="colorPrimaryDark">?attr/colorSurface</item>

        <item name="android:navigationBarColor">?android:attr/colorBackground</item>

        <item name="windowActionModeOverlay">true</item>

        <item name="textAppearanceButton">@style/TextAppearance.Subtitle2</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.Subtitle2</item>
        <!-- Menu Items, EditTexts, Dialog Titles -->
        <item name="textAppearanceSubtitle1">@style/TextAppearance.Subtitle1</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.Headline6</item>

        <!-- Submenu Title -->
        <item name="textAppearancePopupMenuHeader">@style/TextAppearance.Subtitle2.PopupMenu</item>

        <item name="toolbarStyle">@style/Toolbar</item>

        <item name="materialAlertDialogTheme">@style/AlertDialog</item>
    </style>

    <style name="AppTheme" parent="Base.AppTheme">
        <item name="colorPrimaryDark">@color/Black</item>
        <item name="colorPrimary">@color/NotasGold</item>
        <item name="colorOnPrimary">@color/Black</item>
        <item name="alternateFabTint">@color/Black</item>
        <item name="alternateFabBackground">@color/NotasGold</item>
    </style>

    <!-- Tema AMOLED seleccionado explícitamente, independiente del oscuro convencional. -->
    <style name="AppThemeAmoled" parent="Base.AppTheme">
        <item name="colorPrimary">@color/NotasGold</item>
        <item name="colorOnPrimary">@color/Black</item>
        <item name="colorPrimaryDark">@color/Black</item>
        <item name="colorSecondary">@color/NotasGold</item>
        <item name="colorOnSecondary">@color/Black</item>
        <item name="colorSurface">@color/NotasSurface</item>
        <item name="colorOnSurface">@color/NotasWhite</item>
        <item name="alternateFabTint">@color/Black</item>
        <item name="alternateFabBackground">@color/NotasGold</item>
        <item name="android:colorBackground">@color/Black</item>
        <item name="android:windowBackground">@color/Black</item>
        <item name="android:statusBarColor">@color/Black</item>
        <item name="android:navigationBarColor">@color/Black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Widget" parent="AppTheme" />

    <style name="MainActivity" parent="AppTheme">
        <item name="android:statusBarColor">@color/Transparent</item>
    </style>


    <style name="TextAppearance.Headline6.Toolbar">
        <item name="android:textSize">28sp</item>
        <item name="fontFamily">@font/notas_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>

    <style name="TextAppearance.Headline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.Subtitle2" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.Subtitle2.PopupMenu">
        <item name="android:textColor">?attr/colorControlNormal</item>
    </style>


    <style name="Toolbar" parent="Widget.MaterialComponents.Toolbar.Surface">
        <item name="android:background">?android:attr/colorBackground</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="titleTextAppearance">@style/TextAppearance.Headline6.Toolbar</item>
    </style>


    <style name="Preview" parent="Widget.AppCompat.TextView">
        <item name="android:paddingBottom">16dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">?attr/colorControlNormal</item>
        <item name="android:textAppearance">?attr/textAppearanceBody2</item>
    </style>

    <style name="Preview.ListItem">
        <item name="android:paddingBottom">4dp</item>
        <item name="android:drawablePadding">8dp</item>
    </style>

    <style name="TextView.Clickable" parent="Widget.AppCompat.TextView">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="TextView.Clickable.Dialog">
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBody2</item>
    </style>


    <style name="Button.NavigationView" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:checkable">true</item>
        <item name="iconPadding">16dp</item>
        <item name="cornerRadius">0dp</item>
    </style>


    <style name="RadioButton.Chip" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:button">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/navigation_view_item</item>
        <item name="android:textAppearance">?attr/textAppearanceBody2</item>
    </style>


    <style name="AlertDialog.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>


    <style name="AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/AlertDialog.Title</item>
        <item name="shapeAppearanceOverlay">@style/NotasDialogShape</item>
    </style>

    <style name="NotasDialogShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Colorless" parent="ThemeOverlay.MaterialComponents">
        <item name="colorSecondary">?attr/colorOnSurface</item>
    </style>


    <style name="Preference" parent="TextView.Clickable">
        <item name="android:padding">18dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBody1</item>
    </style>

    <style name="PreferenceHeader" parent="Widget.AppCompat.TextView">
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAppearance">?attr/textAppearanceSubtitle2</item>
    </style>


    <style name="Circle" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">50%</item>
    </style>

    <style name="RoundedRectangle" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">16dp</item>
    </style>


    <style name="WidgetPreview.ListItem" parent="Widget.AppCompat.TextView">
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableStart">@drawable/checkbox_outline_16</item>
        <item name="android:textAppearance">@style/TextAppearance.MaterialComponents.Body2</item>
    </style>

    <style name="PillButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">112dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="shapeAppearanceOverlay">@style/Circle</item>
    </style>

</resources>