<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/DrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <RelativeLayout
        android:id="@+id/RelativeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/Toolbar"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="?android:attr/colorBackground"
            android:elevation="0dp"
            app:contentInsetEnd="0dp"
            app:contentInsetStart="0dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/SectionTitle"
                android:layout_marginStart="20dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:gravity="center_vertical"
                android:paddingStart="0dp"
                android:paddingEnd="20dp"
                android:text="@string/notes"
                android:fontFamily="@font/notas_sans"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <!-- Orden explícito; sin márgenes relativos que inviertan iconos. -->
            <LinearLayout
                android:id="@+id/ToolbarActions"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/SyncStatus"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/sync_pending"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/refresh_cw_off"
                    app:tint="@color/NotasMuted" />

                <ImageButton
                    android:id="@+id/OpenSections"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/explore_sections"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/settings"
                    app:tint="?attr/colorOnSurface" />

            </LinearLayout>

            <EditText
                android:id="@+id/EnterSearchKeyword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/search"
                android:inputType="textFilter"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textAppearance="?attr/textAppearanceBody1"
                android:visibility="gone" />

        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Carpetas desde Inicio; nunca dentro de Ajustes ni en el FAB. -->
        <LinearLayout
            android:id="@+id/FoldersBar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_below="@id/Toolbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:id="@+id/OpenFolders"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="3dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/notebook_folders">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/notas_nav_folder"
                    app:tint="@color/NotasGold" />
                <TextView
                    android:id="@+id/FoldersLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/notebook_folders"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:fontFamily="@font/notas_sans" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/CreateFolder"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="9dp"
                android:paddingEnd="8dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/notebook_create">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notebook_create"
                    android:textColor="@color/NotasGold"
                    android:textSize="14sp"
                    android:fontFamily="@font/notas_sans"/>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/ActionMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/colorBackground"
            android:layout_below="@id/FoldersBar"
            app:navigationIcon="?attr/homeAsUpIndicator" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/NavHostFragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/ActionMode"
            app:defaultNavHost="true"
            app:navGraph="@navigation/navigation" />

        <!-- Barra flotante contextual: búsqueda, nota y lista. -->
        <LinearLayout
            android:id="@+id/BottomPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="16dp"
            android:background="@drawable/notas_bottom_pill"
            android:elevation="10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <ImageButton
                android:id="@+id/BottomSearch"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/search"
                android:padding="13dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/search"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/TakeNote"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:background="@drawable/notas_pill_primary"
                android:contentDescription="@string/take_note"
                android:padding="13dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/notas_huge_edit03"
                app:tint="@color/Black" />

            <ImageButton
                android:id="@+id/MakeList"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/make_list"
                android:padding="13dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/notas_huge_checkmark_circle02"
                app:tint="?attr/colorOnSurface" />

        </LinearLayout>

    </RelativeLayout>

    <com.omgodse.notally.view.NavigationView
        android:id="@+id/NavigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:cardCornerRadius="0dp"
        app:cardElevation="16dp">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="always">

            <LinearLayout
                android:id="@+id/LinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="@string/internal_app_name"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:textColor="?attr/colorPrimary" />

                <com.omgodse.notally.view.NavigationViewItem
                    android:id="@+id/Notes"
                    style="@style/Button.NavigationView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/notes"
                    app:icon="@drawable/home" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="?android:attr/listDivider" />

                <com.omgodse.notally.view.NavigationViewItem
                    android:id="@+id/Labels"
                    style="@style/Button.NavigationView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/labels"
                    app:icon="@drawable/label" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="?android:attr/listDivider" />

                <com.omgodse.notally.view.NavigationViewItem
                    android:id="@+id/Deleted"
                    style="@style/Button.NavigationView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/deleted"
                    app:icon="@drawable/delete" />

                <com.omgodse.notally.view.NavigationViewItem
                    android:id="@+id/Archived"
                    style="@style/Button.NavigationView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/archived"
                    app:icon="@drawable/archive" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="?android:attr/listDivider" />

                <com.omgodse.notally.view.NavigationViewItem
                    android:id="@+id/Settings"
                    style="@style/Button.NavigationView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings"
                    app:icon="@drawable/settings" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </com.omgodse.notally.view.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>