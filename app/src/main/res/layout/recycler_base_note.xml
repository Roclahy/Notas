<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="14dp"
    android:checkable="true"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:checkedIcon="@drawable/checked_circle"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:theme="@style/Colorless">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.omgodse.notally.view.AspectRatioImageView
                android:id="@+id/ImageView"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <com.omgodse.notally.view.AspectRatioTextView
                android:id="@+id/Message"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:gravity="center"
                android:text="@string/cant_load_image"
                android:textAppearance="?attr/textAppearanceBody2" />

        </FrameLayout>

        <ImageView
            android:id="@+id/LockIndicator"
            android:layout_width="match_parent"
            android:layout_height="37dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:scaleType="fitEnd"
            android:contentDescription="@string/locked_note"
            android:visibility="gone"
            app:srcCompat="@drawable/notas_lock"
            app:tint="@color/NotasGold" />

        <Space
            android:id="@+id/Space"
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <TextView
            android:id="@+id/Title"
            style="@style/Preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/notas_sans"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textAppearance="?attr/textAppearanceBody1"
            android:textSize="16sp"
            android:paddingBottom="6dp"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/Date"
            style="@style/Preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="5dp"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/Note"
            style="@style/Preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            android:paddingBottom="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <LinearLayout
            android:id="@+id/LinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <TextView
                style="@style/Preview.ListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Preview.ListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Preview.ListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Preview.ListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Preview.ListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Preview.ListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Preview.ListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Preview.ListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Preview.ListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Preview.ListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/ItemsRemaining"
                style="@style/Preview.ListItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/add_16" />

        </LinearLayout>

        <com.omgodse.notally.view.PublicFlowLayout
            android:id="@+id/LabelGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            app:itemSpacing="8dp"
            app:lineSpacing="8dp" />

        <TextView
            android:id="@+id/Reminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:textAppearance="?attr/textAppearanceBody2"
            app:drawableStartCompat="@drawable/reminder_16" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>