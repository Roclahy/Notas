<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:orientation="vertical"
    android:fitsSystemWindows="false">

    <FrameLayout
        android:id="@+id/ToolbarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:elevation="8dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/colorBackground"
            android:minHeight="64dp"
            app:navigationIcon="?attr/homeAsUpIndicator" />

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/Search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/colorBackground"
            android:outlineProvider="none"
            app:navigationIcon="?attr/homeAsUpIndicator">

            <EditText
                android:id="@+id/EnterSearchKeyword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/search"
                android:imeOptions="actionSearch"
                android:inputType="textFilter"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textAppearance="?attr/textAppearanceBody1" />

        </com.google.android.material.appbar.MaterialToolbar>

    </FrameLayout>


    <androidx.core.widget.NestedScrollView
        android:id="@+id/ScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:overScrollMode="never"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <com.omgodse.notally.view.AspectRatioRecyclerView
                android:id="@+id/ImagePreview"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <EditText
                android:id="@+id/EnterTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/title"
                android:imeOptions="actionNext"
                android:inputType="textMultiLine|textCapSentences"
                android:paddingStart="24dp"
                android:paddingTop="22dp"
                android:paddingEnd="16dp"
                android:fontFamily="@font/notas_sans"
                android:textSize="26sp"
                android:textAppearance="?attr/textAppearanceHeadline6" />

            <!-- Metadatos compactos: fecha y estadísticas se adaptan al ancho. -->
            <com.omgodse.notally.view.PublicFlowLayout
                android:id="@+id/InfoPills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                app:itemSpacing="12dp"
                app:lineSpacing="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Icono y fecha se miden juntos para evitar recortes. -->
                    <TextView
                        android:id="@+id/DateCreated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="20dp"
                        android:gravity="center_vertical"
                        android:drawableStart="@drawable/notas_huge_calendar04"
                        android:drawableTint="@color/NotasMuted"
                        android:drawablePadding="6dp"
                        android:text="@string/date"
                        android:textColor="@color/NotasMuted"
                        android:fontFamily="@font/notas_sans"
                        android:includeFontPadding="false"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/WordCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/notas_sans"
                        android:includeFontPadding="false"
                        android:textColor="@color/NotasMuted"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/StatsSeparator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:fontFamily="@font/notas_sans"
                        android:includeFontPadding="false"
                        android:text="·"
                        android:textColor="@color/NotasMuted"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/CharacterCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/notas_sans"
                        android:includeFontPadding="false"
                        android:textColor="@color/NotasMuted"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.omgodse.notally.view.PublicFlowLayout>

            <TextView
                android:id="@+id/Reminder"
                style="@style/TextView.Clickable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingTop="16dp"
                android:paddingEnd="24dp"
                android:paddingBottom="16dp"
                android:textAppearance="?attr/textAppearanceBody2"
                app:drawableStartCompat="@drawable/reminder_20" />

            <!-- Sin línea divisoria: el contenido fluye desde la fecha. -->

            <com.omgodse.notally.view.OverflowEditText
                android:id="@+id/EnterBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/note"
                android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="16dp"
                android:fontFamily="@font/notas_sans"
                android:textAppearance="?attr/textAppearanceBody1" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/RecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="4dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <TextView
                android:id="@+id/AddItem"
                style="@style/TextView.Clickable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp"
                android:text="@string/add_item"
                android:textAppearance="?attr/textAppearanceSubtitle2"
                android:textColor="?android:textColorHint"
                app:drawableStartCompat="@drawable/add"
                app:drawableTint="?android:textColorHint" />

            <TextView
                android:id="@+id/AudioHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingTop="16dp"
                android:paddingEnd="24dp"
                android:paddingBottom="12dp"
                android:text="@string/audio_recordings"
                android:textAppearance="?attr/textAppearanceSubtitle2" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/AudioRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <com.omgodse.notally.view.PublicFlowLayout
                android:id="@+id/LabelGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingTop="16dp"
                android:paddingEnd="24dp"
                app:itemSpacing="8dp"
                app:lineSpacing="8dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


</LinearLayout>